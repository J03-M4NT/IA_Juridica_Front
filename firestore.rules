rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un usuario es admin SOLO si su documento en /users tiene role ==
    // 'admin'. Ese campo se asigna a mano desde la consola de Firebase
    // (que no pasa por estas reglas) — ninguna escritura desde la página
    // puede crearlo ni cambiarlo (ver /users abajo).
    function esAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Regla para la colección de usuarios
    match /users/{userId} {
      // Cada usuario solo ve su propio perfil (y los admins, todos)
      allow read: if request.auth != null && (request.auth.uid == userId || esAdmin());

      // Crear el propio perfil, pero SIN campo "role": un usuario nuevo
      // es siempre usuario normal (userProfile.isAdmin lo trata así).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !('role' in request.resource.data);

      // Editar el propio perfil (nombre, foto...), pero nunca el "role" —
      // ni agregarlo, ni cambiarlo, ni borrarlo.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Permitir lectura y escritura en la subcolección del historial de consultas
      match /consultas/{consultaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Regla para la colección de contratos
    // Solo usuarios autenticados pueden leer (no escritura desde el frontend)
    match /contratos/{contratoId} {
      allow read: if request.auth != null;
      allow write: if false; // Solo se escriben desde la consola de Firebase
    }

    // Regla para las normas del día (escritas por la Cloud Function de
    // scraping vía Admin SDK, que no pasa por estas reglas)
    match /normas_diarias/{fecha} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Regla para las plantillas de contrato
    // Cualquier usuario autenticado puede leerlas; solo un admin puede
    // subir/eliminar plantillas (coincide con userProfile.isAdmin, que
    // usa el mismo campo "role" del documento de usuario)
    match /contract_templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // Cupo diario de IA por usuario y caché de resúmenes de normas: los
    // maneja solo el Admin SDK desde las Cloud Functions (seguridad.ts,
    // geminiTools.ts). Si el cliente pudiera escribir aquí, podría
    // reiniciar su propio contador.
    match /uso_ia/{userId} {
      allow read, write: if false;
    }
    match /resumenes_normas/{id} {
      allow read, write: if false;
    }

  }
}

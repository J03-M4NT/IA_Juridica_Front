rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regla para las fotos de perfil
    match /profile-photos/{userId}/{fileName} {
      // Permitir lectura a cualquier usuario autenticado
      allow read: if request.auth != null;
      
      // Permitir escritura solo al propio usuario
      // Validar que sea una imagen y menor a 5MB
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Documentos Word temporales adjuntados en Consultas (ver
    // documentosTemporalesService.ts) — privados por usuario, para poder
    // abrirlos en Word de escritorio vía una URL firmada. "documentos-
    // temporales" va PRIMERO en la ruta (no dentro de usuarios/{uid}/) a
    // propósito: así una Lifecycle Rule del bucket puede usar un prefijo
    // literal ("documentos-temporales/") que borra estos archivos a los 3
    // días sin importar el uid — Cloud Storage Lifecycle no soporta
    // comodines en medio de la ruta.
    match /documentos-temporales/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    // Agregar aquí otras reglas para otros directorios según sea necesario
  }
}
